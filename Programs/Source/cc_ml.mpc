from Compiler.library import ConsistencyCheck
from Compiler import ml

CC = ConsistencyCheck()


# party 1 provides the training data
X = sint.input_tensor_via(1, [[1, 2, 3], [11, 12, 13]])
y = sint.input_tensor_via(1, [0, 1])

# parties compute input commitments in MPC
CC.commit(X)
CC.commit(y)

# => all parties obtain commitments C_X and C_y

# parties train model in MPC
log = ml.SGDLogistic(100)
log.fit(X, y)

# party 0 uses model to make prediction
x = sint.input_tensor_via(0, [[3, 4, 5]])

y_pred = log.predict(x)

print_ln(y_pred.reveal()[0])


