C_X = "85a73a28c59e7b2c7fc09ad4dc09e0389372d335eeb7923992be62c5fc9ab28868bb2b892fb246ccb208acbde181e3c4"
C_y = "ad3eb50121139aa34db1d545093ac9374ab7bca2c0f3bf28e27c8dcd8fc7cb42d25926fc0c97b336e9f0fb35e5a04c81"

# check the input w.r.t the commitments
